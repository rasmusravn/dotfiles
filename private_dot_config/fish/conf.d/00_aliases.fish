# Personal aliases loaded automatically by fish
alias rm "rm -i"
alias cp "cp -i"
alias vim nvim
alias mv "mv -i"
alias mkdir "mkdir -p"
alias h history
alias which "type -a"
alias cm chezmoi
alias ce "chezmoi edit --apply"
alias mount_pi "sudo sshfs -o allow_other,default_permissions pi@192.168.0.10:/home/pi/ /mnt/pi"
alias pip "uv pip"
