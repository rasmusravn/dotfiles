# ~/.config/chezmoi/chezmoi.toml.tmpl
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $name := promptStringOnce . "name" "Full or work name" -}}
{{- $obsidian_vault_path := promptStringOnce . "vault" "Obsidian vault path" -}}
{{- $raspberry_pi_ip := promptStringOnce . "pi" "Raspberry Pi IP address" -}}
[data]
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  obsidian_vault_path = {{ $obsidian_vault_path | quote }}
  raspberry_pi_ip = {{ $raspberry_pi_ip | quote }}

  [data.monitors]
    laptop = "eDP-1"
    external = "HDMI-A-1"

  [data.font]
    monospace = "JetBrainsMono Nerd Font"

[edit]
  command = "nvim"
  args = ["-f"]

[template]
  options = ["missingkey=error"]

[data.linux]
  pdf_viewer = "zathura"

[git]
  autoCommit = true
  autoPush = true
