#!/bin/bash
# A simplified script to toggle display output between a laptop and external monitor.
# It uses a state file to remember the current display.
#

LAPTOP="eDP-1"
# EXTERNAL="DP-1"
EXTERNAL="HDMI-A-1"

# --- Script Logic ---
STATE_FILE="/tmp/sway_screen_state"

# If the state file doesn't exist, default to the laptop screen.
if [ ! -f "$STATE_FILE" ]; then
    echo "laptop" > "$STATE_FILE"
fi

CURRENT_STATE=$(cat "$STATE_FILE")

if [ "$CURRENT_STATE" = "laptop" ]; then
    # --- Try to switch from LAPTOP to EXTERNAL ---

    # Check if the external monitor is connected by looking for a line starting with "Output"
    # followed by the monitor name.
    if swaymsg -t get_outputs | grep -q $EXTERNAL; then
        echo "Switching to External display ($EXTERNAL)"
        swaymsg "output '$LAPTOP' disable; output '$EXTERNAL' enable"
        # Update the state to reflect the change
        echo "external" > "$STATE_FILE"
    else
        # If the monitor isn't connected, notify the user and do nothing.
        swaynag -t warning -m "External monitor ($EXTERNAL) not detected."
        exit 1
    fi
else
    # --- Switch from EXTERNAL to LAPTOP ---
    echo "Switching to Laptop display ($LAPTOP)"
    swaymsg "output '$EXTERNAL' disable; output '$LAPTOP' enable"
    # Update the state to reflect the change
    echo "laptop" > "$STATE_FILE"
fi
