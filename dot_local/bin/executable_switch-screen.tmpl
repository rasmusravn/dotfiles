#!/bin/bash
{{- /* switch-screen.tmpl */ -}}
#
# Toggles output between the laptop screen and an external monitor.
#

LAPTOP="{{ .monitors.laptop }}"
EXTERNAL="{{ .monitors.external }}"
STATE_FILE="/tmp/screen_toggle_state"

# If the state file doesn't exist, default to laptop and create it
if [ ! -f "$STATE_FILE" ]; then
    echo "laptop" > "$STATE_FILE"
fi

# Read the current state and switch to the other
if [ "$(cat $STATE_FILE)" = "laptop" ]; then
    echo "Switching to external monitor: $EXTERNAL"
    swaymsg "output '$LAPTOP' disable; output '$EXTERNAL' enable"
    echo "external" > "$STATE_FILE"
else
    echo "Switching to laptop screen: $LAPTOP"
    swaymsg "output '$EXTERNAL' disable; output '$LAPTOP' enable"
    echo "laptop" > "$STATE_FILE"
fi
