#!/bin/bash
{{- /* switch-screen.tmpl */ -}}
#
# Toggles display output between the laptop and external monitor in Sway,
# ensuring only one is active at a time.
#
# This script is idempotent and determines the current state by querying sway.
#
# Depends on: sway, jq

# --- Configuration from chezmoi data ---
# Define these in your chezmoi.toml file, e.g.:
# [data.monitors]
#   laptop = "eDP-1-0"
#   external = "HDMI-A-1-0"
LAPTOP="{{ .monitors.laptop }}"
EXTERNAL="{{ .monitors.external }}"

# --- Script Logic ---

# Find the absolute path to jq to avoid PATH issues when run from sway
JQ_CMD=""
if [ -x "/usr/bin/jq" ]; then
    JQ_CMD="/usr/bin/jq"
elif [ -x "/bin/jq" ]; then
    JQ_CMD="/bin/jq"
fi

# Check if jq was found. If not, send a desktop notification and exit.
if [ -z "$JQ_CMD" ]; then
    swaynag -t error -m "Dependency 'jq' could not be found in /usr/bin or /bin. Please install it."
    exit 1
fi

# Get the JSON output from sway about all connected displays
outputs=$(swaymsg -t get_outputs)

# Check if the external monitor is currently active
# We use jq to parse the JSON: find the object where .name matches our external monitor
# and then return the value of its .active property.
external_is_active=$(echo "$outputs" | $JQ_CMD --arg name "$EXTERNAL" '.[] | select(.name == $name) | .active')

if [ "$external_is_active" = "true" ]; then
    # If the external monitor is active, switch to the laptop.
    # We send two separate commands to avoid timing issues.
    echo "Switching to Laptop display ($LAPTOP)"
    swaymsg "output '$EXTERNAL' disable"
    swaymsg "output '$LAPTOP' enable"
else
    # If the external monitor is not active, switch to it.
    echo "Switching to External display ($EXTERNAL)"
    swaymsg "output '$LAPTOP' disable"
    swaymsg "output '$EXTERNAL' enable"
fi
