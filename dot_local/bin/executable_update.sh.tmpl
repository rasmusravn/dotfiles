#!/bin/bash
# Personal update script, generated by chezmoi

set -e

{{ if eq .chezmoi.os "linux" -}}
{{   if (eq .chezmoi.osRelease.id "debian" "ubuntu" "pop") -}}
echo "--- Updating apt packages ---"
sudo apt-get update && sudo apt-get upgrade -y
{{   else if (eq .chezmoi.osRelease.id "fedora" "centos") -}}
echo "--- Updating dnf packages ---"
sudo dnf upgrade --refresh -y
{{   else if (eq .chezmoi.osRelease.id "arch") -}}
echo "--- Updating pacman packages ---"
sudo pacman -Syu --noconfirm
{{   else -}}
echo "No supported package manager found for linux distribution {{ .chezmoi.osRelease.id }}." >&2
exit 1
{{   end -}}
{{ else if eq .chezmoi.os "windows" -}}
echo "--- Updating winget packages ---"
# winget upgrade --all --include-unknown
echo "Windows update logic would go here."
{{ end -}}
